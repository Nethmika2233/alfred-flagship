# Copy this file to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string (this project was built against Neon, but any
# Postgres-compatible provider works). Get one free at https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign auth session tokens. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Cloudinary credentials for seller product photo uploads.
# Create a free account at https://cloudinary.com, then find these on your
# Dashboard under "Product Environment Credentials".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
